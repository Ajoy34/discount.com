{
  "name": "discounty",
  "version": "1.0.0",
  "private": true,
  "description": "Discounty — hyperlocal shop, offer and business consultancy platform for Bangladesh",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:export": "vitest run --config vitest.export.config.ts",
    "test:e2e": "playwright test",
    "serve:out": "node tests/static-server.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:export && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.47.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.0.1"
  }
}
